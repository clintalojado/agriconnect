PORT=4000
DB_PATH=./src/data/agriconnect.db

# --- NLP (reading farmer messages) ---
# Claude API key. Leave empty to use the offline rule-based parser only.
ANTHROPIC_API_KEY=
# auto  = Claude, falling back to the rule-based parser if the API is unavailable (default)
# ai    = Claude only (errors surface to the user)
# rules = rule-based parser only, no network calls
NLP_MODE=auto

# --- Farmer verification (BPMN phase 1) ---
# required = new farmers wait for a barangay / LGU / cooperative verifier (default)
# auto     = new farmers are verified immediately (demos only)
FARMER_VERIFICATION=required

# --- SMS gateway ---
# console (default: print texts to the server log; OTP codes are shown on screen) | android | semaphore | twilio
SMS_PROVIDER=console
# SMS Gateway for Android (free; sms-gate.app) — install on a phone with a SIM, turn on
# Cloud server, copy the username/password here, then: npm run sms:webhook -- https://<your-host>
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Optional: the signing key from the app's webhook settings (verifies X-Signature)
SMSGATE_SIGNING_KEY=
# Optional: only for a self-hosted server
SMSGATE_URL=
# Optional shared secret the gateway must send to POST /api/sms/inbound
# (as ?secret=... or an X-Webhook-Secret header)
SMS_WEBHOOK_SECRET=
# Semaphore (semaphore.co)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Facebook Messenger ---
# Webhook: https://<your-host>/api/messenger/webhook (subscribe the page to "messages").
# Without a page token, replies are printed to the server log (use the staff simulator).
MESSENGER_PAGE_TOKEN=
MESSENGER_VERIFY_TOKEN=
# If set, webhook payloads must carry a valid X-Hub-Signature-256.
MESSENGER_APP_SECRET=
